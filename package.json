{
  "name": "exclusive-apparel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build && node scripts/finalize-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "images:optimize": "node scripts/optimize-store-images.mjs",
    "postinstall": "node scripts/patch-lucide.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.11",
    "react-server-dom-webpack": "19.3.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "^5.8.0",
    "vinext": "1.2.0",
    "vite": "8.3.4",
    "wrangler": "4.151.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "fflate": "0.8.3",
    "esbuild": "0.28.2"
  }
}
