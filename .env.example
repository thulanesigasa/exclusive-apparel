# Pre-launch defaults; keep both switches aligned.
NEXT_PUBLIC_STOREFRONT_MODE=waitlist
STOREFRONT_MODE=waitlist
# Generate with: openssl rand -hex 32; server only, never NEXT_PUBLIC_.
WAITLIST_ADMIN_SECRET=
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# Your Cloudflare D1 UUID; never deploy the zero-filled local placeholder.
D1_DATABASE_ID=
# Optional: only needed later for owner-uploaded product media, not the bundled photos.
R2_BUCKET_NAME=
# Hosted runtime configuration; never commit actual values.
ADMIN_EMAILS=
STORE_MODE=test
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
# Server-only Resend key for the verified exclusive-apparel.co.za sending domain.
RESEND_API_KEY=
# Future order emails only; waiting-list sender is fixed to noreply@exclusive-apparel.co.za.
EMAIL_FROM=
# Enable only after email/SMTP and the RLS migration have been verified.
CUSTOMER_AUTH_READY=false
SUPABASE_URL=https://vasdsmzsmquvpepaxzog.supabase.co
# Server-only service role/secret key; NEVER use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Enable after activating FormSubmit in 1exclusiveapparel@gmail.com.
FORMSUBMIT_ENABLED=false
# Optional opaque FormSubmit activation token; recipient defaults to the Gmail above.
FORMSUBMIT_TOKEN=
SUPABASE_PUBLISHABLE_KEY=
# 32 random bytes encoded as 64 lowercase hex characters, server only.
AUTH_SESSION_KEY=
